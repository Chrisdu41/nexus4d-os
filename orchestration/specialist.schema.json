{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS 4D Specialist Contract",
  "type": "object",
  "required": ["specialist", "task", "inputs", "output"],
  "properties": {
    "specialist": {"type": "string"},
    "task": {"type": "string"},
    "inputs": {
      "type": "object",
      "required": ["objective", "facts", "inferences", "hypotheses", "unknowns"],
      "properties": {
        "objective": {"type": "string"},
        "facts": {"type": "array"},
        "inferences": {"type": "array"},
        "hypotheses": {"type": "array"},
        "unknowns": {"type": "array"},
        "previous_learnings": {"type": "array"}
      }
    },
    "output": {
      "type": "object",
      "required": ["observations", "inferences", "hypotheses", "deliverables", "risks", "open_questions", "next_recommended_action"],
      "properties": {
        "observations": {"type": "array"},
        "inferences": {"type": "array"},
        "hypotheses": {"type": "array"},
        "deliverables": {"type": "array"},
        "risks": {"type": "array"},
        "open_questions": {"type": "array"},
        "next_recommended_action": {"type": "string"},
        "evidence": {"type": "array"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    }
  }
}
